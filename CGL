#include <GL/freeglut.h>
#include <stdio.h>
#include <math.h>
#include <string.h>

// ============================================================
// SMART CAMPUS NAVIGATOR
// CO1 + CO2
//
// CO1:
// OpenGL graphics primitives:
// GL_QUADS, GL_LINES, GL_TRIANGLES,
// GL_POINTS, GL_LINE_LOOP
//
// CO2:
// Translation  -> glTranslatef()
// Scaling      -> glScalef()
// Rotation     -> glRotatef()
//
// DDA:
// ddaLine() is used for drawing campus connections.
// ============================================================

// ------------------------------------------------------------
// CO2 Transformation variables
// ------------------------------------------------------------

float moveX = 0.0f;
float moveY = 0.0f;
float scaleValue = 1.0f;
float rotationAngle = 0.0f;


// ------------------------------------------------------------
// DDA LINE ALGORITHM
// ------------------------------------------------------------

void ddaLine(float x1, float y1, float x2, float y2)
{
    float dx = x2 - x1;
    float dy = y2 - y1;

    float steps;

    if (fabs(dx) > fabs(dy))
        steps = fabs(dx);
    else
        steps = fabs(dy);

    if (steps == 0)
    {
        glBegin(GL_POINTS);
        glVertex2f(x1, y1);
        glEnd();
        return;
    }

    float xIncrement = dx / steps;
    float yIncrement = dy / steps;

    float x = x1;
    float y = y1;

    glBegin(GL_POINTS);

    for (int i = 0; i <= (int)steps; i++)
    {
        glVertex2f(round(x), round(y));

        x += xIncrement;
        y += yIncrement;
    }

    glEnd();
}


// ------------------------------------------------------------
// Text
// ------------------------------------------------------------

void drawText(float x, float y, const char *text)
{
    glRasterPos2f(x, y);

    for (int i = 0; text[i] != '\0'; i++)
    {
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_12, text[i]);
    }
}


// ------------------------------------------------------------
// Building colors
// ------------------------------------------------------------

void setBuildingColor(int building)
{
    if (building == 0)
        glColor3f(0.20f, 0.55f, 0.90f);     // A

    else if (building == 1)
        glColor3f(0.30f, 0.75f, 0.40f);     // B

    else if (building == 2)
        glColor3f(0.90f, 0.55f, 0.20f);     // C

    else
        glColor3f(0.70f, 0.40f, 0.80f);     // D
}


// ------------------------------------------------------------
// Building position
// ------------------------------------------------------------

float buildingX(int building)
{
    if (building == 0)
        return -500;

    if (building == 1)
        return -170;

    if (building == 2)
        return 160;

    return 490;
}


// ------------------------------------------------------------
// Draw room
// CO1 -> GL_QUADS + GL_LINE_LOOP
// ------------------------------------------------------------

void drawRoom(float x, float y, int building, int floor, int room)
{
    float width = 45;
    float height = 32;

    setBuildingColor(building);

    // Room filled rectangle
    glBegin(GL_QUADS);

    glVertex2f(x, y);
    glVertex2f(x + width, y);
    glVertex2f(x + width, y + height);
    glVertex2f(x, y + height);

    glEnd();


    // Room border
    glColor3f(0.05f, 0.05f, 0.05f);

    glBegin(GL_LINE_LOOP);

    glVertex2f(x, y);
    glVertex2f(x + width, y);
    glVertex2f(x + width, y + height);
    glVertex2f(x, y + height);

    glEnd();


    // Room number
    char name[10];

    char block = 'A' + building;

    int roomNumber;

    if (floor == 0)
        roomNumber = room + 1;
    else if (floor == 1)
        roomNumber = 101 + room;
    else
        roomNumber = 201 + room;

    sprintf(name, "%c%03d", block, roomNumber);

    glColor3f(0.0f, 0.0f, 0.0f);

    drawText(x + 10, y + 13, name);
}


// ------------------------------------------------------------
// Draw one building
// ------------------------------------------------------------

void drawBuilding(int building)
{
    float bx = buildingX(building);

    // Building title
    char title[20];

    sprintf(title, "BLOCK %c", 'A' + building);

    glColor3f(0.0f, 0.0f, 0.0f);

    drawText(bx + 65, 315, title);


    // --------------------------------------------------------
    // Ground floor
    // --------------------------------------------------------

    float y0 = 230;

    for (int r = 0; r < 5; r++)
    {
        drawRoom(
            bx + r * 52,
            y0,
            building,
            0,
            r
        );
    }


    // --------------------------------------------------------
    // First floor
    // --------------------------------------------------------

    float y1 = 120;

    for (int r = 0; r < 5; r++)
    {
        drawRoom(
            bx + r * 52,
            y1,
            building,
            1,
            r
        );
    }


    // --------------------------------------------------------
    // Second floor
    // --------------------------------------------------------

    float y2 = 10;

    for (int r = 0; r < 5; r++)
    {
        drawRoom(
            bx + r * 52,
            y2,
            building,
            2,
            r
        );
    }
}


// ------------------------------------------------------------
// Draw exact room connectivity
// Uses DDA algorithm
// ------------------------------------------------------------

void drawRoomConnections(int building)
{
    float bx = buildingX(building);

    float ys[3] =
    {
        230,
        120,
        10
    };

    glColor3f(0.0f, 0.0f, 0.0f);

    glPointSize(2.0f);

    for (int floor = 0; floor < 3; floor++)
    {
        for (int r = 0; r < 4; r++)
        {
            float x1 = bx + r * 52 + 45;
            float y1 = ys[floor] + 16;

            float x2 = bx + (r + 1) * 52;
            float y2 = ys[floor] + 16;

            // DDA line
            ddaLine(x1, y1, x2, y2);
        }
    }
}


// ------------------------------------------------------------
// Staircase connections
// ------------------------------------------------------------

void drawStairs(int building)
{
    float bx = buildingX(building);

    glColor3f(0.15f, 0.15f, 0.15f);

    // Ground -> First
    ddaLine(
        bx + 22,
        230,
        bx + 22,
        152
    );

    // First -> Second
    ddaLine(
        bx + 22,
        120,
        bx + 22,
        42
    );

    // Stair labels

    glColor3f(0.0f, 0.0f, 0.0f);

    char stairText[20];

    sprintf(
        stairText,
        "%c Stairs",
        'A' + building
    );

    drawText(
        bx + 25,
        175,
        stairText
    );

    drawText(
        bx + 25,
        65,
        stairText
    );
}


// ------------------------------------------------------------
// Building entrance connections
// ------------------------------------------------------------

void drawEntrance(int building)
{
    float bx = buildingX(building);

    glColor3f(0.8f, 0.1f, 0.1f);

    ddaLine(
        bx + 100,
        330,
        bx + 22,
        246
    );
}


// ------------------------------------------------------------
// Building-to-building connections
// Exact connectivity:
//
// A <-> B
// A <-> C
// A <-> D
// B <-> C
// B <-> D
// C <-> D
// ------------------------------------------------------------

void drawBuildingConnections()
{
    glColor3f(0.9f, 0.1f, 0.1f);

    // A - B
    ddaLine(
        -200,
        330,
        -170,
        330
    );

    // A - C
    ddaLine(
        -100,
        300,
        160,
        300
    );

    // A - D
    ddaLine(
        -50,
        340,
        490,
        340
    );

    // B - C
    ddaLine(
        90,
        300,
        160,
        300
    );

    // B - D
    ddaLine(
        90,
        350,
        490,
        350
    );

    // C - D
    ddaLine(
        420,
        300,
        490,
        300
    );
}


// ------------------------------------------------------------
// Campus Gate
// ------------------------------------------------------------

void drawGate()
{
    glColor3f(0.95f, 0.75f, 0.1f);

    glBegin(GL_QUADS);

    glVertex2f(-90, -90);
    glVertex2f(90, -90);
    glVertex2f(90, -40);
    glVertex2f(-90, -40);

    glEnd();


    glColor3f(0.0f, 0.0f, 0.0f);

    glBegin(GL_LINE_LOOP);

    glVertex2f(-90, -90);
    glVertex2f(90, -90);
    glVertex2f(90, -40);
    glVertex2f(-90, -40);

    glEnd();


    drawText(-35, -70, "CAMPUS GATE");
}


// ------------------------------------------------------------
// Gate -> Buildings
// ------------------------------------------------------------

void drawGateConnections()
{
    glColor3f(0.1f, 0.1f, 0.1f);

    // Gate -> A
    ddaLine(
        -40,
        -40,
        -450,
        230
    );

    // Gate -> B
    ddaLine(
        -10,
        -40,
        -120,
        230
    );

    // Gate -> C
    ddaLine(
        10,
        -40,
        180,
        230
    );

    // Gate -> D
    ddaLine(
        40,
        -40,
        510,
        230
    );
}


// ------------------------------------------------------------
// Building markers
// CO1 -> GL_POINTS
// ------------------------------------------------------------

void drawMarkers()
{
    glPointSize(8.0f);

    glColor3f(1.0f, 0.0f, 0.0f);

    glBegin(GL_POINTS);

    glVertex2f(-470, 350);
    glVertex2f(-140, 350);
    glVertex2f(190, 350);
    glVertex2f(520, 350);

    glEnd();

    glPointSize(1.0f);
}


// ------------------------------------------------------------
// Legend
// ------------------------------------------------------------

void drawLegend()
{
    glColor3f(0.0f, 0.0f, 0.0f);

    drawText(
        -650,
        -330,
        "SMART CAMPUS NAVIGATOR"
    );

    drawText(
        -650,
        -350,
        "Arrow Keys : Translation"
    );

    drawText(
        -650,
        -370,
        "+ / - : Zoom"
    );

    drawText(
        -650,
        -390,
        "R : Rotation"
    );

    drawText(
        -300,
        -350,
        "0 : Reset"
    );

    drawText(
        -300,
        -370,
        "ESC : Exit"
    );

    drawText(
        100,
        -350,
        "CO1 : OpenGL Primitives"
    );

    drawText(
        100,
        -370,
        "CO2 : Geometric Transformations"
    );

    drawText(
        100,
        -390,
        "DDA : Line Drawing Algorithm"
    );
}


// ------------------------------------------------------------
// Display
// ------------------------------------------------------------

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    glMatrixMode(GL_MODELVIEW);

    glLoadIdentity();


    // ========================================================
    // CO2
    // Apply transformations to CO1 graphics
    // ========================================================

    glTranslatef(moveX, moveY, 0.0f);

    glRotatef(
        rotationAngle,
        0.0f,
        0.0f,
        1.0f
    );

    glScalef(
        scaleValue,
        scaleValue,
        1.0f
    );


    // ========================================================
    // CO1 GRAPHICS
    // ========================================================

    // Buildings
    for (int b = 0; b < 4; b++)
    {
        drawBuilding(b);
        drawRoomConnections(b);
        drawStairs(b);
        drawEntrance(b);
    }


    // Building connections
    drawBuildingConnections();


    // Campus gate
    drawGate();


    // Gate connections
    drawGateConnections();


    // Map markers
    drawMarkers();


    // ========================================================
    // Control panel
    // Kept as part of the transformed scene
    // ========================================================

    drawLegend();


    glutSwapBuffers();
}


// ------------------------------------------------------------
// Keyboard
// ------------------------------------------------------------

void keyboard(unsigned char key, int x, int y)
{
    switch (key)
    {
        // Zoom in
        case '+':
            scaleValue += 0.1f;
            break;


        // Zoom out
        case '-':
            scaleValue -= 0.1f;

            if (scaleValue < 0.3f)
                scaleValue = 0.3f;

            break;


        // Rotation
        case 'r':
        case 'R':
            rotationAngle += 10.0f;

            if (rotationAngle >= 360)
                rotationAngle -= 360;

            break;


        // Reset
        case '0':
            moveX = 0.0f;
            moveY = 0.0f;
            scaleValue = 1.0f;
            rotationAngle = 0.0f;
            break;


        // Exit
        case 27:
            exit(0);
    }

    glutPostRedisplay();
}


// ------------------------------------------------------------
// Special keyboard
// Arrow keys -> Translation
// ------------------------------------------------------------

void specialKeys(int key, int x, int y)
{
    switch (key)
    {
        case GLUT_KEY_LEFT:
            moveX -= 10.0f;
            break;

        case GLUT_KEY_RIGHT:
            moveX += 10.0f;
            break;

        case GLUT_KEY_UP:
            moveY += 10.0f;
            break;

        case GLUT_KEY_DOWN:
            moveY -= 10.0f;
            break;
    }

    glutPostRedisplay();
}


// ------------------------------------------------------------
// Initialization
// ------------------------------------------------------------

void init()
{
    glClearColor(
        0.92f,
        0.95f,
        1.0f,
        1.0f
    );

    glMatrixMode(GL_PROJECTION);

    glLoadIdentity();

    gluOrtho2D(
        -700,
        700,
        -450,
        450
    );

    glMatrixMode(GL_MODELVIEW);

    glLoadIdentity();
}


// ------------------------------------------------------------
// Main
// ------------------------------------------------------------

int main(int argc, char **argv)
{
    glutInit(&argc, argv);

    glutInitDisplayMode(
        GLUT_DOUBLE |
        GLUT_RGB
    );

    glutInitWindowSize(
        1400,
        900
    );

    glutCreateWindow(
        "Smart Campus Navigator - CO1 + CO2 + DDA"
    );


    init();


    glutDisplayFunc(display);

    glutKeyboardFunc(keyboard);

    glutSpecialFunc(specialKeys);


    glutMainLoop();

    return 0;
}
