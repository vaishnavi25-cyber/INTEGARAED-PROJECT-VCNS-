// =====================================================
// UPDATE BUILDING
// =====================================================

void updateBuilding()
{
    string oldName = inputLine("Enter building name: ");

    int index = findBuildingIndex(oldName);

    if (index == -1)
    {
        cout << "Building not found.\n";
        return;
    }

    string newName = inputLine("Enter new building name: ");

    if (newName.empty() || findBuildingIndex(newName) != -1)
    {
        cout << "Invalid or duplicate building name.\n";
        return;
    }

    buildings[index].name = newName;

    rebuildCampusGraph();

    cout << "Building updated.\n";
}

// =====================================================
// UPDATE ROOM
// =====================================================

void updateRoom()
{
    string oldRoom = inputLine("Enter existing room number: ");

    int b, f, r;

    if (!findRoomDetails(oldRoom, b, f, r))
    {
        cout << "Room not found.\n";
        return;
    }

    string newRoom = inputLine("Enter new room number: ");

    int tb, tf, tr;

    if (newRoom.empty() || findRoomDetails(newRoom, tb, tf, tr))
    {
        cout << "Invalid or duplicate room.\n";
        return;
    }

    buildings[b].room[f][r] = newRoom;

    rebuildCampusGraph();

    cout << "Room updated.\n";
}

// =====================================================
// INSERT BUILDING
// =====================================================

void insertBuilding()
{
    if (buildingCount >= MAX_BUILDINGS)
    {
        cout << "Building array is full.\n";
        return;
    }

    string name = inputLine("Enter building name: ");
    string code = inputLine("Enter building code: ");

    if (name.empty() || code.empty() ||
        findBuildingIndex(name) != -1)
    {
        cout << "Invalid or duplicate building.\n";
        return;
    }

    for (int i = 0; i < MAX_BUILDINGS; i++)
    {
        if (buildings[i].active &&
            toLowerCase(buildings[i].code) == toLowerCase(code))
        {
            cout << "Building code already exists.\n";
            return;
        }
    }

    int index = -1;

    for (int i = 0; i < MAX_BUILDINGS; i++)
    {
        if (!buildings[i].active)
        {
            index = i;
            break;
        }
    }

    if (index == -1)
    {
        cout << "No free building slot.\n";
        return;
    }

    initializeBuilding(index, name, code);
    buildingCount++;

    rebuildCampusGraph();

    cout << "Building and rooms inserted.\n";
}

// =====================================================
// DELETE BUILDING
// =====================================================

void deleteBuilding()
{
    string name = inputLine("Enter building name to delete: ");

    int index = findBuildingIndex(name);

    if (index == -1)
    {
        cout << "Building not found.\n";
        return;
    }

    for (int i = 0; i < facultyCount; i++)
    {
        if (!faculty[i].active)
            continue;

        for (int j = 0; j < 3; j++)
        {
            int b, f, r;

            if (findRoomDetails(faculty[i].room[j], b, f, r)
                && b == index)
            {
                cout << "Cannot delete: faculty is assigned here.\n";
                return;
            }
        }
    }

    buildings[index].active = false;
    buildingCount--;

    rebuildCampusGraph();

    cout << "Building deleted.\n";
}

