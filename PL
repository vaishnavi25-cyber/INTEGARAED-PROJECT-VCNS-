void initializeBuilding(int index, string name, string code)
{
    buildings[index].name = name;
    buildings[index].code = code;
    buildings[index].active = true;

    for (int f = 0; f < FLOORS; f++)
    {
        if (f == 0)
            buildings[index].floor[f] = "Ground Floor";
        else if (f == 1)
            buildings[index].floor[f] = "1st Floor";
        else
            buildings[index].floor[f] = "2nd Floor";

        for (int r = 0; r < ROOMS; r++)
        {
            buildings[index].room[f][r] =
                code + to_string(f) + "0" + to_string(r + 1);
        }
    }
}

int findBuildingIndex(string name)
{
    for (int i = 0; i < MAX_BUILDINGS; i++)
    {
        if (buildings[i].active &&
            toLowerCase(buildings[i].name) == toLowerCase(name))
        {
            return i;
        }
    }

    return -1;
}

bool findRoomDetails(string room, int &b, int &f, int &r)
{
    for (int i = 0; i < MAX_BUILDINGS; i++)
    {
        if (!buildings[i].active)
            continue;

        for (int j = 0; j < FLOORS; j++)
        {
            for (int k = 0; k < ROOMS; k++)
            {
                if (toLowerCase(buildings[i].room[j][k]) ==
                    toLowerCase(room))
                {
                    b = i;
                    f = j;
                    r = k;
                    return true;
                }
            }
        }
    }

    return false;
}

