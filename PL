// =====================================================
// CO2: LINKED LIST GRAPH
// =====================================================

struct Edge
{
    int destination;
    int distance;
    Edge* next;
};

struct GraphNode
{
    string name;
    Edge* head;
};

GraphNode graph[MAX_NODES];
int nodeCount = 0;

// =====================================================
// GRAPH NODE OPERATIONS
// =====================================================

int findNode(string name)
{
    for (int i = 0; i < nodeCount; i++)
    {
        if (toLowerCase(graph[i].name) == toLowerCase(name))
            return i;
    }

    return -1;
}

int addNode(string name)
{
    int existing = findNode(name);

    if (existing != -1)
        return existing;

    if (nodeCount >= MAX_NODES)
        return -1;

    graph[nodeCount].name = name;
    graph[nodeCount].head = nullptr;

    nodeCount++;

    return nodeCount - 1;
}

void addDirectedEdge(int from, int to, int distance)
{
    if (from < 0 || to < 0)
        return;

    Edge* current = graph[from].head;

    while (current != nullptr)
    {
        if (current->destination == to)
        {
            current->distance = distance;
            return;
        }

        current = current->next;
    }

    Edge* newEdge = new Edge;

    newEdge->destination = to;
    newEdge->distance = distance;
    newEdge->next = graph[from].head;

    graph[from].head = newEdge;
}

void connectPlaces(string a, string b, int distance)
{
    int first = addNode(a);
    int second = addNode(b);

    if (first == -1 || second == -1)
        return;

    addDirectedEdge(first, second, distance);
    addDirectedEdge(second, first, distance);
}

// =====================================================
// ADD BUILDING AND ROOM NODES
// =====================================================

void addBuildingGraph(int index)
{
    if (!buildings[index].active)
        return;

    string buildingName = buildings[index].name;

    addNode(buildingName);

    for (int f = 0; f < FLOORS; f++)
    {
        for (int r = 0; r < ROOMS; r++)
        {
            string roomName = buildings[index].room[f][r];

            addNode(roomName);

            // Building to room connection
            connectPlaces(buildingName, roomName, 5);
        }
    }
}

