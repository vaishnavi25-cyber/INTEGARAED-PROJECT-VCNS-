// =====================================================
// CLEAR GRAPH MEMORY
// =====================================================

void clearGraph()
{
    for (int i = 0; i < nodeCount; i++)
    {
        Edge* current = graph[i].head;

        while (current != nullptr)
        {
            Edge* temp = current;
            current = current->next;

            delete temp;
        }

        graph[i].head = nullptr;
    }

    nodeCount = 0;
}

void rebuildCampusGraph()
{
    clearGraph();
    createCampusGraph();
}

