// =====================================================
// BFS SHORTEST PATH
// =====================================================

void shortestRoute()
{
    string start = inputLine("Enter starting location: ");
    string destination = inputLine("Enter destination: ");

    int source = findNode(start);
    int target = findNode(destination);

    if (source == -1 || target == -1)
    {
        cout << "Location not found.\n";
        return;
    }

    int parent[MAX_NODES];
    bool visited[MAX_NODES] = {};

    for (int i = 0; i < MAX_NODES; i++)
        parent[i] = -1;

    queue<int> q;

    q.push(source);
    visited[source] = true;

    while (!q.empty())
    {
        int current = q.front();
        q.pop();

        if (current == target)
            break;

        Edge* edge = graph[current].head;

        while (edge != nullptr)
        {
            int next = edge->destination;

            if (!visited[next])
            {
                visited[next] = true;
                parent[next] = current;
                q.push(next);
            }

            edge = edge->next;
        }
    }

    if (!visited[target])
    {
        cout << "No route available.\n";
        return;
    }

    int path[MAX_NODES];
    int length = 0;

    for (int current = target;
         current != -1;
         current = parent[current])
    {
        path[length++] = current;
    }

    reverse(path, path + length);

    int totalDistance = 0;

    cout << "\n===== ROUTE =====\n";

    for (int i = 0; i < length; i++)
    {
        cout << graph[path[i]].name;

        if (i < length - 1)
        {
            int next = path[i + 1];

            Edge* edge = graph[path[i]].head;

            while (edge != nullptr)
            {
                if (edge->destination == next)
                {
                    totalDistance += edge->distance;
                    break;
                }

                edge = edge->next;
            }

            cout << " -> ";
        }
    }

    cout << "\nDistance: " << totalDistance << " metres\n";

    // Assumed walking speed: 1.2 metres per second
    int seconds = totalDistance / 1.2;

    cout << "Estimated walking time: "
         << seconds / 60 << " minutes "
         << seconds % 60 << " seconds\n";
}

